{%- comment -%}
  Share image and Open Graph tags with a fallback, so links to the homepage and
  collections show a picture in Facebook, iMessage, WhatsApp and Pinterest.
  For: stores whose homepage has no og:image.
  Install: add to snippets/, then inside <head> in layout/theme.liquid add
    {% render 'social-meta' %}
  and remove the theme's older social meta include if it has one.
  Also set a default image in Online Store > Preferences > Social sharing image.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="{{ page_image.width }}">
<meta property="og:image:height" content="{{ page_image.height }}">
{%- endif %}
{%- if request.page_type == 'product' %}
<meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">
